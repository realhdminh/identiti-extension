{
  "name": "identiti",
  "description": "Export and import browser site data (cookies, storage, IndexedDB) with optional encryption.",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "wxt prepare",
    "lint": "biome check --unsafe src",
    "format": "biome check --write --unsafe src"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@webext-core/messaging": "^4.0.1",
    "@wxt-dev/auto-icons": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "idb": "^8.0.4",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^2.5.3",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^2.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "wxt": "^0.21.5"
  }
